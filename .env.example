TP_BASE_URL=https://tp.point.online/api/ext
TP_BASE_TOKEN=
TP_AUTH_TIMEOUT_SECONDS=20
TP_API_TIMEOUT_SECONDS=20
TP_TICKETS_MAX_PAGES=100
TP_USERS_CACHE_TTL_SECONDS=300
GIS_BASE_URL=https://map.example
GIS_API_TOKEN=
GIS_TIMEOUT_SECONDS=20
S3_ENDPOINT_URL=http://seaweedfs:8333
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=techportal-reports
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=https://s2.svc.point.online/techportal-reports
S3_TIMEOUT_SECONDS=20
GIS_COMPLETION_WORKER_POLL_SECONDS=5
GIS_COMPLETION_WORKER_BATCH_SIZE=10
TP_LOGIN=
TP_PASSWORD=
ESB_BASE_URL=https://esb.example
ESB_BASE_TOKEN=
ESB_TIMEOUT_SECONDS=20
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_SESSION_DB=0
REDIS_CACHE_DB=1
REDIS_BOT_DB=2
DATABASE_URL=postgresql+asyncpg://techportal:change-me@postgres:5432/techportal
POSTGRES_DB=techportal
POSTGRES_USER=techportal
POSTGRES_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
MESSENGER_SHOW=false
TG_ACCESS_GROUPS=
TG_ACCESS_CACHE_TTL_SECONDS=300
TG_LINK_TOKEN_TTL_SECONDS=600
SESSION_COOKIE_NAME=tp_pwa_session
SESSION_COOKIE_SECURE=true
SESSION_ABSOLUTE_TTL_SECONDS=43200
SESSION_IDLE_TTL_SECONDS=28800
PAYMENT_ADDRESSES_CACHE_TTL_SECONDS=300
BX24_WEBHOOK=
BX24_PAYMENT_PRODUCTS={}
BX24_PRICE_GROUP_ID=2
BX24_NEW_LEAD_STATUS_ID=NEW
BX24_PAYMENT_CURRENCY=RUB
BX24_PAYMENT_MIN_AMOUNT=1.00
BX24_PAYMENT_MAX_AMOUNT=1000000.00
BX24_PAYMENT_ALLOW_PRICE_OVERRIDE=true
BX24_PAYMENT_LINK_FIELD=
BX24_PAYMENT_SEND_TRIGGER=
# CRM activity in addition to the timeline comment; disabled by default.
BX24_PAYMENT_CREATE_ACTIVITY=false
BX24_PAYMENT_WEBHOOK_TOKEN=
BX24_PAYMENT_POLL_INTERVAL_SECONDS=30
BX24_PAYMENT_EXPIRES_SECONDS=86400
BX24_PAYMENT_CATALOG_CACHE_TTL_SECONDS=300
BX24_TIMEOUT_SECONDS=20
BX24_WORKER_BATCH_SIZE=10
BX24_WORKER_MAX_RETRIES=8
ALLOWED_ORIGINS=http://localhost:8080
LOG_LEVEL=INFO
HTTPS_PROXY=
ADMIN_BASE_PATH=/admin/
PAYMENT_TELEMETRY_ENABLED=false
# Use --profile events with events mode; legacy uses the same durable jobs via DB polling.
COMPOSE_PROFILES=legacy
PAYMENT_PROCESSING_MODE=legacy
PAYMENT_EVENTS_REDIS_URL=redis://redis:6379/3
PAYMENT_EVENTS_PREFIX=tp-pwa
PAYMENT_OUTBOX_POLL_SECONDS=1
PAYMENT_RECOVERY_INTERVAL_SECONDS=30
PAYMENT_LEASE_SECONDS=90
PAYMENT_HEARTBEAT_SECONDS=15
PAYMENT_RECLAIM_IDLE_MS=90000
PAYMENT_SHUTDOWN_GRACE_SECONDS=30
#число одновременных задач внутри одного контейнера-воркера.
#  - PAYMENT_FORMATION_CONCURRENCY=1 — один formation-worker берёт и формирует только одну оплату за раз.
#  - PAYMENT_RECONCILIATION_CONCURRENCY=1 — один reconciliation-worker за раз сверяет статус только одной оплаты.
PAYMENT_FORMATION_CONCURRENCY=1
PAYMENT_RECONCILIATION_CONCURRENCY=1
#число контейнеров-воркеров
PAYMENT_FORMATION_REPLICAS=1
PAYMENT_RECONCILIATION_REPLICAS=1

# Conservative application budget, not a claim about the portal's REST limit.
PAYMENT_BITRIX_REQUESTS_PER_SECOND=1
PAYMENT_BITRIX_COOLDOWN_SECONDS=30
# Queue diagnostics run independently of PAYMENT_TELEMETRY_ENABLED.
PAYMENT_HEALTH_INTERVAL_SECONDS=30
PAYMENT_HEALTH_DUE_AGE_SECONDS=120
PAYMENT_HEALTH_OUTBOX_AGE_SECONDS=10
PAYMENT_STREAM_RETENTION_ENABLED=false
PAYMENT_STREAM_RETENTION_DAYS=30
PAYMENT_STREAM_RETENTION_BATCH_SIZE=50
PAYMENT_STREAM_RETENTION_INTERVAL_SECONDS=600
PAYMENT_JOB_RETENTION_ENABLED=false
PAYMENT_JOB_RETENTION_DAYS=30
PAYMENT_JOB_RETENTION_BATCH_SIZE=50
PAYMENT_JOB_RETENTION_INTERVAL_SECONDS=600
