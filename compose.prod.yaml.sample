services:
  admin-frontend:
    restart: unless-stopped
    environment:
      ADMIN_BASE_PATH: ${ADMIN_BASE_PATH:-/admin/}
  frontend:
      restart: unless-stopped
  api:
    restart: unless-stopped
    environment:
      SESSION_COOKIE_SECURE: "true"
      PAYMENT_ADDRESSES_CACHE_TTL_SECONDS: ${PAYMENT_ADDRESSES_CACHE_TTL_SECONDS:-300}
      ALLOWED_ORIGINS: "https://pwa.example.ru"
  telegram-bot:
    restart: unless-stopped
  payment-worker:
    restart: unless-stopped
  redis:
    restart: unless-stopped
    command:
      - redis-server
      - --appendonly
      - "yes"
      - --appendfsync
      - everysec
      - --maxmemory
      - 256mb
      - --maxmemory-policy
      - noeviction
    mem_limit: 384m
  postgres:
    restart: unless-stopped
  seaweedfs:
    restart: unless-stopped
  vector:
    restart: unless-stopped
    mem_limit: 256m
    logging:
      driver: local
      options:
        max-size: "20m"
        max-file: "5"
